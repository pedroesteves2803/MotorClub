APP_NAME=MotorClub
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=33067
DB_DATABASE=motorclub
DB_USERNAME=motorclub
DB_PASSWORD=local-only-change-me
# Produção Aiven: informe o certificado da CA em Base64 como DB_SSL_CA_B64.
DB_SSL_CA_B64=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
PRIVATE_FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8015/auth/google/callback

# Produção: desative demonstrações e confirme persistência/restauração antes de publicar.
DEMO_ENABLED=true
SUPPORT_EMAIL=
STORAGE_PERSISTENT=false
BACKUPS_VERIFIED=false
SESSION_SECURE_COOKIE=false
# Homologação publicada: APP_ENV=staging exige senha adicional.
TEST_MODE=true
STAGING_ACCESS_USER=motorclub
STAGING_ACCESS_PASSWORD=

# Assinaturas Stripe: somente modo de testes nesta versão.
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Simulador local sem credenciais. Use stripe para integrar o sandbox externo.
BILLING_DRIVER=mock

# Relatórios técnicos demonstrativos locais. Nenhuma IA externa é chamada.
MOTORCLUB_AI_PROVIDER=fake
SHOTS_PLATFORM_COMMISSION=10
SHOTS_PREVIEW_MAX_DIMENSION=1200
SHOTS_PREVIEW_WEBP_QUALITY=80
SHOTS_WATERMARK_OPACITY=52
SHOTS_WATERMARK_COUNT=7
SHOTS_WATERMARK_TEXT="MOTORCLUB SHOTS"
SHOTS_WATERMARK_PHOTOGRAPHER=true

# Recursos visíveis no MVP público.
FEATURE_GARAGE=true
FEATURE_SHOTS=true
FEATURE_EXPLORE=true
FEATURE_AI_REPORTS=false
FEATURE_WORKSHOPS=false
FEATURE_EVENTS=false
FEATURE_SUBSCRIPTIONS=false
FEATURE_DEMO=false
